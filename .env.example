VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Resend (email notifications) — server-side only, set in Vercel ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ChainWork <notifications@yourdomain.com>
# Optional: redirect every notification to this address (for testing).
NOTIFY_OVERRIDE_TO=you@example.com

# --- PayPal (server-side only — NEVER prefix the secret with VITE_) ---
# PAYPAL_MODE controls both the OAuth host and which credentials are used.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=AY...sandbox-client-id...
PAYPAL_CLIENT_SECRET=EL...sandbox-secret...
# Public client id used by the PayPal button. The browser fetches this from
# /api/paypal/config — do NOT add a VITE_ variant for the secret.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AY...sandbox-client-id...

# --- Supabase service-role key (server-side only) ---
# Required for /api/paypal/* to write to the payments table. NEVER expose this
# to the browser — the VITE_ key must stay the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...

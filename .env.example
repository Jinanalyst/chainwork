VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Resend (email notifications) — server-side only, set in Vercel ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ChainWork <notifications@yourdomain.com>
# Optional: redirect every notification to this address (for testing).
NOTIFY_OVERRIDE_TO=you@example.com

# --- NOWPayments (server-side only — NEVER prefix with VITE_) ---
# REST API key used by /api/nowpayments/create-invoice to create invoices.
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
# IPN secret used by /api/nowpayments/webhook to verify the x-nowpayments-sig
# header. Set the IPN callback URL in the NOWPayments dashboard to
# https://your-domain/api/nowpayments/webhook
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
# Optional: explicit IPN callback URL. If unset, it is derived from the request
# host (recommended only when you have a stable custom domain).
# NOWPAYMENTS_IPN_CALLBACK_URL=https://your-domain/api/nowpayments/webhook

# --- Supabase service-role key (server-side only) ---
# Required for /api/nowpayments/* to write to the payments / payment_proofs
# tables. NEVER expose this to the browser — the VITE_ key must stay the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...

# --- Talent Reward Program (server-side only) ---
# Shared secret guarding POST /api/rewards/run. Callers send it as
# `Authorization: Bearer <secret>` or `x-cron-secret`. The Vercel Cron in
# vercel.json must pass the same value. Generate one with e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REWARDS_CRON_SECRET=your-long-random-secret

# --- NOWPayments Mass Payout (server-side only) — used by /api/rewards/payout ---
# Payout API key (may differ from the invoice key; falls back to NOWPAYMENTS_API_KEY).
NOWPAYMENTS_PAYOUT_API_KEY=your-nowpayments-payout-api-key
# Account email + password — exchanged for a short-lived JWT before each payout.
NOWPAYMENTS_EMAIL=you@yourdomain.com
NOWPAYMENTS_PASSWORD=your-nowpayments-account-password
# Optional: explicit payout IPN callback. If unset, derived from the request host
# as https://your-domain/api/rewards/payout-webhook (the settlement webhook).
# NOWPAYMENTS_PAYOUT_IPN_URL=https://your-domain/api/rewards/payout-webhook
